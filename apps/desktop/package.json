{
  "name": "@mayak/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && electron .",
    "build": "tsc -p tsconfig.json && electron-builder --linux dir",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "app.mayak.desktop",
    "productName": "Mayak",
    "executableName": "mayak",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server"
      },
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../examples/demo-mcp-server/dist/index.mjs",
        "to": "demo-mcp-server/index.mjs"
      }
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility"
    }
  }
}
