# Порт HTTP API. Веб-интерфейс в dev проксирует /api сюда.
PORT=8787

# Локально слушайте только этот интерфейс: в базе лежат API-ключи.
# На VPS за reverse proxy поставьте 0.0.0.0.
HOST=127.0.0.1

# Многопользовательский режим (регистрация менеджеров). Десктоп его не включает.
# MAYAK_AUTH=1
# MAYAK_SINGLE_USER=1
# Длинная случайная строка. Обязательна, если MAYAK_AUTH=1 на сервере.
# JWT_SECRET=
# 1, когда сайт открыт по HTTPS (cookie с флагом Secure).
# COOKIE_SECURE=1

# Пусто — SQLite в DATA_DIR. Иначе Postgres, SQLite не используется.
# DATABASE_URL=postgres://mayak:mayak@127.0.0.1:5432/mayak

# Каталог данных: SQLite, навыки, секреты.
# По умолчанию <корень репозитория>/data
# DATA_DIR=./data

# Необязательно. Если заданы BASE_URL, API_KEY и MODEL, при первом запуске
# создаётся OpenAI-совместимый провайдер (OpenAI, OpenRouter, Ollama, LM Studio, Groq).
# MAYAK_OPENAI_NAME=OpenRouter
# MAYAK_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MAYAK_OPENAI_API_KEY=sk-or-...
# MAYAK_OPENAI_MODEL=openai/gpt-4o-mini

# Необязательно. Если задан, при каждом запуске сервера появляется провайдер
# DeepSeek (https://api.deepseek.com, модели deepseek-chat и deepseek-reasoner).
# Новые чаты выбирают deepseek-chat. Ключ остаётся в SQLite и не уходит в браузер.
# DEEPSEEK_API_KEY=sk-...

# Необязательно. Вход через GitHub OAuth App вместо вставки токена вручную.
# Callback: <MAYAK_PUBLIC_URL>/api/github/oauth/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MAYAK_PUBLIC_URL=https://mayak.example.com

# Порт, который docker-compose.vps.yml публикует наружу. Внутри контейнера остаётся 8787.
# MAYAK_PORT=8090

# Веб-поиск. В настройках админа можно выбрать brave или tavily и сохранить ключ.
# SEARXNG_URL=http://searxng:8080

# Песочница run_code по умолчанию выключена (настройка админа). Нужен Docker на сервере.
# Уведомления Telegram: токен бота сохраняется в настройках, не здесь.

# Прокси для API моделей (OpenAI, Anthropic, Gemini недоступны из некоторых стран).
# Только HTTP(S)-прокси. Остальные запросы (DeepSeek, Telegram, whisper) идут напрямую.
# LLM_PROXY_URL=http://user:password@host:port
# Список хостов через запятую; по умолчанию api.openai.com,api.anthropic.com,generativelanguage.googleapis.com
# LLM_PROXY_HOSTS=
